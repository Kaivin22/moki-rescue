# Copy to .env.docker.local (ignored by Git). Never commit real credentials.
OSRM_DATA_DIR=E:/path/to/processed-osrm-data
OSRM_HOST_PORT=5001
BACKEND_HOST_PORT=8082
# Set 0.0.0.0 only when testing from your phone on a trusted LAN.
BACKEND_BIND_ADDRESS=127.0.0.1
SPRING_DATASOURCE_URL=jdbc:postgresql://your-host:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=motorescue_api
SPRING_DATASOURCE_PASSWORD=replace-locally
SUPABASE_URL=https://your-project.supabase.co
CORS_ALLOWED_ORIGINS=http://localhost:8081
ASSISTANT_ENABLED=false
