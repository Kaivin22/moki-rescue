    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:ci && expo install --check && expo config --type public",
    "dev:backend": "node scripts/start-development.cjs --backend",
    "dev:frontend": "node scripts/start-development.cjs --frontend-only",
    "dev": "node scripts/start-development.cjs"
  },
  "private": true
