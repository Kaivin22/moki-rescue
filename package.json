  "scripts": {
    "start": "node scripts/start-development.cjs",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:ci": "jest --runInBand --ci",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" \"__tests__/**/*.ts\" \"locales/*.json\" \"*.{js,json}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" \"__tests__/**/*.ts\" \"locales/*.json\" \"*.{js,json}\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:ci && expo install --check && expo config --type public",
    "dev:backend": "node scripts/start-development.cjs --backend",
    "dev:frontend": "node scripts/start-development.cjs --frontend-only",
    "dev": "node scripts/start-development.cjs"
  },
  "private": true
