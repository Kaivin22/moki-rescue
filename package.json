    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:ci": "jest --runInBand --ci",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" \"__tests__/**/*.ts\" \"locales/*.json\" \"*.{js,json}\"",
