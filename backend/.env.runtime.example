# Reference variables for a directly launched Java API (terminal/IDE/service).
# Spring Boot does not automatically import this dotenv file. Never use these for integration tests.
# Never commit the copy. Values below are deliberately unusable placeholders.
SPRING_DATASOURCE_URL=jdbc:postgresql://db.example.invalid:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=motorescue_api
SPRING_DATASOURCE_PASSWORD=replace-with-runtime-role-password
SUPABASE_URL=https://project.example.invalid
OSRM_MOTORBIKE_BASE_URL=https://routing.example.invalid
CORS_ALLOWED_ORIGINS=http://localhost:8081
ASSISTANT_ENABLED=false
# Required only when enabling the assistant; never copy into EXPO_PUBLIC_*.
GEMINI_API_KEY=
EXPO_ACCESS_TOKEN=
