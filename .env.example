# ══════════════════════════════════════════════════════
# DaNang Itinerary — Environment Variables
# ══════════════════════════════════════════════════════
# Sao chép file này thành `.env` và điền giá trị thực:
#   cp .env.example .env
#
# ⚠️  KHÔNG commit file .env lên Git!
# ══════════════════════════════════════════════════════

# Supabase project URL (lấy từ Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (public key, safe to use in client)
SUPABASE_ANON_KEY=your-anon-key-here
