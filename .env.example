# MotoRescue Da Nang - environment template
# Copy to .env for local development. Never commit .env or real credentials.

# Mobile-safe configuration. Values prefixed EXPO_PUBLIC_ are embedded in the app.
APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key
# Backend origin or reverse-proxy prefix before `/api` (do not append `/api`).
EXPO_PUBLIC_API_URL=http://192.168.1.10:8080
EXPO_PUBLIC_EAS_PROJECT_ID=replace-with-eas-project-id
EXPO_PUBLIC_SUPPORT_HOTLINE=19000000

# Embedded in native binaries: restrict by Android package/SHA-1 and iOS bundle ID.
GOOGLE_MAPS_KEY=replace-with-restricted-mobile-key

# Backend-only configuration. Never prefix these values with EXPO_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SPRING_DATASOURCE_URL=jdbc:postgresql://your-host:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=motorescue_api
SPRING_DATASOURCE_PASSWORD=replace-with-database-password
TERMS_VERSION=2026-08-22

# Backend-only Gemini configuration. Never expose this key through EXPO_PUBLIC_.
# The assistant is restricted to MotoRescue usage/support and does not diagnose vehicles.
ASSISTANT_ENABLED=true
GEMINI_API_KEY=replace-with-server-side-gemini-key
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ASSISTANT_REQUESTS_PER_MINUTE=5
ASSISTANT_REQUESTS_PER_DAY=30
ASSISTANT_MAX_OUTPUT_TOKENS=350
API_MUTATIONS_PER_MINUTE=60
API_LOCATION_UPDATES_PER_MINUTE=15
API_ASSISTANT_ATTEMPTS_PER_MINUTE=10
RESCUE_CREATE_WINDOW=10m
RESCUE_MAX_CREATES_PER_WINDOW=3
RESCUE_REQUEST_LIST_LIMIT=100
PROVIDER_CHECKPOINT_DEDUPE_SECONDS=3

# Reputation policy. Low ratings open an admin review signal; they never auto-suspend a team.
QUALITY_MINIMUM_RATINGS=5
QUALITY_WARNING_AVERAGE=3.5
QUALITY_CRITICAL_AVERAGE=3.0
QUALITY_REPEAT_AFTER_NEW_RATINGS=3
QUALITY_WARNINGS_BEFORE_SUSPENSION_REVIEW=3
QUALITY_ADMIN_REVIEW_LIST_LIMIT=30

# Must point to an OSRM dataset preprocessed with a verified motorcycle profile.
# The public Project OSRM demo server is not a production dependency.
OSRM_MOTORBIKE_BASE_URL=https://routing-motorbike.example.com
OSRM_PROFILE=driving
OSRM_MAX_SNAP_RADIUS_METERS=750
OSRM_TABLE_BATCH_SIZE=80

MATCHING_OFFER_COUNT=3
MATCHING_OFFER_TTL_SECONDS=45
MATCHING_EXPIRY_SCAN_INTERVAL_MS=15000
PROVIDER_LOCATION_MAX_AGE_SECONDS=180
PROVIDER_LOCATION_MAX_ACCURACY_METERS=150

SERVICE_MIN_LATITUDE=15.85
SERVICE_MAX_LATITUDE=16.25
SERVICE_MIN_LONGITUDE=107.95
SERVICE_MAX_LONGITUDE=108.35

# Optional when Expo push access security is disabled; otherwise keep server-side.
EXPO_ACCESS_TOKEN=
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2

# Android/iOS signing credentials belong in EAS Credentials or a secret manager,
# not in this file and not in the repository workspace.
