# ══════════════════════════════════════════════════════
# DaNang Itinerary — Environment Variables
# ══════════════════════════════════════════════════════
# Sao chép file này thành `.env` và điền giá trị thực:
#   cp .env.example .env
#
# ⚠️  KHÔNG commit file .env lên Git!
# ══════════════════════════════════════════════════════

# Supabase configuration
APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Spring Boot Backend API URL
EXPO_PUBLIC_API_URL=http://localhost:8080/api
EXPO_PUBLIC_EAS_PROJECT_ID=replace-with-eas-project-id
# Khóa Maps sẽ nằm trong binary mobile: bắt buộc giới hạn theo Android package/SHA-1
# và iOS bundle identifier trong Google Cloud Console.
GOOGLE_MAPS_KEY=replace-with-restricted-mobile-key

# Server-only variables. Never prefix these with EXPO_PUBLIC_ and never put
# them in app.config.js `extra`.
SUPABASE_URL=https://your-project.supabase.co
GEMINI_API_KEY=replace-with-server-secret
GEMINI_MODEL=gemini-2.5-flash
# Mỗi URL phải trỏ tới một OSRM instance đã preprocess đúng profile.
# `driving` trong path API không tự đổi dataset thành xe máy/đi bộ/xe đạp.
# Demo router.project-osrm.org chỉ nên dùng local cho ô tô, không dùng production.
OSRM_CAR_BASE_URL=https://routing-car.example.com
OSRM_MOTORBIKE_BASE_URL=https://routing-motorbike.example.com
OSRM_WALK_BASE_URL=https://routing-walk.example.com
OSRM_BICYCLE_BASE_URL=https://routing-bicycle.example.com
OSRM_MAX_SNAP_RADIUS_METERS=750
EXPO_PUBLIC_OSRM_CAR_BASE_URL=https://routing-car.example.com
EXPO_PUBLIC_OSRM_MOTORBIKE_BASE_URL=https://routing-motorbike.example.com
EXPO_PUBLIC_OSRM_WALK_BASE_URL=https://routing-walk.example.com
EXPO_PUBLIC_OSRM_BICYCLE_BASE_URL=https://routing-bicycle.example.com
EXPO_PUBLIC_WEATHER_API_URL=https://api.open-meteo.com
AI_FREE_DAILY_QUOTA=8
AI_VIP_DAILY_QUOTA=80
AI_REQUESTS_PER_MINUTE=20
SPRING_DATASOURCE_URL=jdbc:postgresql://your-host:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace-with-db-password
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
